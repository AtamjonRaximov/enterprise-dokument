FG.format(h)]};var k={hash:"upgrade",itemTitle:"How does upgrading from "+GG+" to "+IG+" work?",description:["Your billing renewal date will remain the same, and the charge for your first month will be prorated as described below. Subsequent renewals will be at the full monthly price (shown above).","Your initial charge will be less than the full monthly price if you are upgrading from "+GG+". Specifically, it will reflect a prorated charge for "+IG+", as well as a prorated credit for your most recent payment for "+
GG+".","For example, if there is only \u2153 of the month left in your current billing cycle when you upgrade to "+IG+", then the amount you will be charged when you upgrade will be \u2153 of the full price of a "+IG+" subscription, minus \u2153 the monthly price of "+GG+" (a discount reflecting the fact that you already paid for your "+GG+" subscription at the beginning of the billing cycle).","The exact amount of your first monthly charge will be shown to you before your purchase is finalized. Subsequent months will renew at the full monthly price shown above.",
"There are no prorated refunds if you later cancel your subscription to "+IG+".","There is also no way to downgrade from "+IG+" to "+GG+" (although you can cancel "+IG+" and then re-subscribe to "+GG+" once your pre-paid month of "+IG+" has lapsed.)"]},l="You may cancel your subscription any time at "+fj(FG,"a",{href:a})+"payments.google.com"+hj(FG,"a")+" under Subscriptions & services. After cancellation, your "+GG+" or "+IG+" benefits will continue to be available to you until a month after your final payment.",
m="Please verify that you are using the correct Google account and payments profile on "+fj(FG,"a",{href:a})+"payments.google.com"+hj(FG,"a")+" in order to be able to see and cancel your subscription.",n="Except in cases provided for by law (e.g. exercise of your right of withdrawal), compute units purchased from "+HG+" or granted via "+GG+" or "+IG+" are not refundable and not transferable, and expire after 90 days.",p="If you have a subscription through a "+fj(FG,"strong")+"Workspace organization"+
hj(FG,"strong")+", you will need to contact your Workspace administrator to make changes. They can update your subscription status at "+fj(FG,"a",{href:"https://admin.google.com",target:"_blank"})+"admin.google.com"+hj(FG,"a");l=[FG.format(l),FG.format(m),n];aG&&l.push(FG.format(p));p={hash:"cancel",itemTitle:"How can I cancel Colab purchases?",description:l};l="How can I downgrade from "+IG+" to "+GG+"?";b="Unfortunately, the only way to downgrade is by canceling "+IG+" at "+fj(FG,"a",{href:a})+
"payments.google.com"+hj(FG,"a")+", then subscribing to "+GG+" at "+fj(FG,"a",{href:b})+"colab.research.google.com/signup"+hj(FG,"a")+".";b=FG.format(b);return[{hash:"gpu",itemTitle:"What kinds of GPUs are available in Colab?",description:["In the version of Colab that is free of charge there is very limited access to GPUs. Usage limits are much lower than they are in paid versions of Colab.","With paid versions of Colab you are able to upgrade to powerful premium GPUs subject to availability and your compute unit balance. The types of GPUs available will vary over time."]},
c,{hash:"memory",itemTitle:"How much memory is available in Colab?",description:["In the version of Colab that is free of charge you are able to access VMs with a standard system memory profile.","Paid subscribers of Colab are able to access machines with a high memory system profile subject to availability and your compute unit balance.","Note that memory refers to system memory. All GPU chips have the same memory profile."]},e,f,d,h,k,p,{hash:"downgrade",itemTitle:l,description:[b]},{hash:"relax",
itemTitle:"How can I relax compute limits?",description:["You can purchase a subscription via "+GG+" or "+IG+" which will allocate you compute units every month.","Additionally, everyone can purchase more compute units via "+HG+", even if they have already been granted compute units as part of their subscription.","In order to prevent you from acquiring compute units you may not use, we restrict the purchase of compute units if you already have a substantial compute unit balance."]},{hash:"ccu",itemTitle:"What are compute units?",
description:["Compute units give you the ability to run your notebook on powerful Google Cloud VMs. The amount of access a compute unit gives you depends on the configuration of your VM and use of specialized accelerators like TPUs or GPUs.","Compute units expire after 90 days. Purchase more as you need them."]},{hash:"zero",itemTitle:"What happens when I have zero compute units?",description:["All users can access Colab resources subject to availability. If you have zero compute units you can use Colab to the degree we can support our users who do not pay fees for the service."]},
{hash:"balance",itemTitle:"What is my compute unit balance?",description:["You can view your compute unit balance in the resource monitor."]},{hash:"running-out",itemTitle:"When will I need to purchase more compute units?",description:["We will notify you in Colab when your compute unit balance is running low, and provide you the option to purchase more if you choose.","After your purchase, we may not be able to preserve your current runtime and may assign a fresh one. Please save your work."]},{hash:"ccu",
itemTitle:SRa,description:["Yes! Subscribing to Colab Pro or Pro+ gives you access to higher RAM runtimes, and in the case of Pro+, access to background execution.","Colab Pro and Pro+ subscriptions will grant you additional compute units every month."]},{hash:"ai-coding-access",itemTitle:"How do I get access to AI coding in Colab?",description:["We are slowly rolling out AI coding features like AI-enabled autocompletions, natural language to code, and a chatbot all based on Gemini.","Users in select locales have access to these features now. Select AI features are available for a limited time for unsubscribed users."]},
{hash:"ai-coding-paid-sub",itemTitle:"I'm a paid subscriber and I don't see AI coding features, what's going on?",description:["Only users in select locales have access to AI coding features. To get access to AI coding features:","Confirm your account age is 18+","AI-enabled autocompletions will appear as you type. Natural language to code and the chatbot both have visible buttons ('generate' and 'Gemini').If you see neither of those, and you've confirmed you should have access, please report feedback in product (\"Help > Send feedback\"). If you want a response via email, you must select the box titled 'We may email you for more information or updates'."]}]}
